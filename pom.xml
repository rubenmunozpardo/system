<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>20a1f58d-0747-4ed0-a965-d048572aa2ac</groupId>
  <artifactId>system</artifactId>
  <version>1.1.1-SNAPSHOT</version>
  <packaging>mule-application</packaging>
  <name>system</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <app.runtime>4.11.0</app.runtime>
    <mule.maven.plugin.version>4.7.0</mule.maven.plugin.version>
  </properties>

  <distributionManagement>
    <repository>
      <id>exchange-v3</id>
      <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/20a1f58d-0747-4ed0-a965-d048572aa2ac/maven</url>
    </repository>
    <snapshotRepository>
      <id>exchange-v3</id>
      <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/20a1f58d-0747-4ed0-a965-d048572aa2ac/maven</url>
    </snapshotRepository>
  </distributionManagement>

  <profiles>
    <profile>
      <id>dev</id>
      <properties>
        <env>dev</env>
        <applicationName>system-dev</applicationName>
        <environmentName>DEV</environmentName>
      </properties>
    </profile>
    <profile>
      <id>pre</id>
      <properties>
        <env>pre</env>
        <applicationName>system-pre</applicationName>
        <environmentName>PRE</environmentName>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>

      <plugin>
        <groupId>org.mule.tools.maven</groupId>
        <artifactId>mule-maven-plugin</artifactId>
        <version>4.7.0</version>
        <extensions>true</extensions>
        <configuration>
          <cloudhub2Deployment>
            <uri>https://anypoint.mulesoft.com</uri>

            <applicationName>${applicationName}</applicationName>
            <muleVersion>4.11.0</muleVersion>
            <environment>${environmentName}</environment>

            <businessGroupId>20a1f58d-0747-4ed0-a965-d048572aa2ac</businessGroupId>
            <region>eu-west-1</region>

            <connectedAppClientId>${env.CA_CLIENT_ID}</connectedAppClientId>
            <connectedAppClientSecret>${env.CA_CLIENT_SECRET}</connectedAppClientSecret>
            <connectedAppGrantType>client_credentials</connectedAppGrantType>

            <replicas>1</replicas>
            <vCores>0.1</vCores>
          </cloudhub2Deployment>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.mule.connectors</groupId>
      <artifactId>mule-http-connector</artifactId>
      <version>1.11.1</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency>
      <groupId>org.mule.connectors</groupId>
      <artifactId>mule-sockets-connector</artifactId>
      <version>1.2.7</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency>
      <groupId>org.mule.modules</groupId>
      <artifactId>mule-apikit-module</artifactId>
      <version>1.11.13</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency>
      <groupId>20a1f58d-0747-4ed0-a965-d048572aa2ac</groupId>
      <artifactId>api-system</artifactId>
      <version>1.0.0</version>
      <classifier>raml</classifier>
      <type>zip</type>
    </dependency>
    <dependency>
      <groupId>com.mulesoft.modules</groupId>
      <artifactId>mule-secure-configuration-property-module</artifactId>
      <version>1.3.0</version>
      <classifier>mule-plugin</classifier>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>anypoint-exchange-v3</id>
      <name>Anypoint Exchange</name>
      <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
      <layout>default</layout>
    </repository>
    <repository>
      <id>mulesoft-releases</id>
      <name>MuleSoft Releases Repository</name>
      <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
      <layout>default</layout>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>mulesoft-releases</id>
      <name>MuleSoft Releases Repository</name>
      <layout>default</layout>
      <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>